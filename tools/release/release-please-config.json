{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "release", "section": "Release", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "infra", "section": "Infrastructure", "hidden": true }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "deployground",
      "components": ["deployground", "golden-path-chart", "deployground-chart"]
    }
  ],
  "packages": {
    ".": {
      "package-name": "deployground",
      "component": "deployground",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/deployground/__init__.py"]
    },
    "helm/charts/golden-path": {
      "release-type": "helm",
      "package-name": "golden-path-chart",
      "component": "golden-path-chart",
      "changelog-path": "helm/charts/golden-path/CHANGELOG.md"
    },
    "helm/charts/deployground": {
      "release-type": "helm",
      "package-name": "deployground-chart",
      "component": "deployground-chart",
      "changelog-path": "helm/charts/deployground/CHANGELOG.md"
    }
  }
}
